{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://veraxis.one/schemas/raed.identity.v0.1.schema.json",
  "title": "RAED Identity v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "namespace",
    "normalized_ref",
    "object_type",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "namespace": {
      "type": "string",
      "minLength": 1
    },
    "normalized_ref": {
      "type": "string",
      "minLength": 1
    },
    "object_type": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
